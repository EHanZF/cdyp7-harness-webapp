{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CDYP7 API - FastAPI/Uvicorn stable",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "console": "internalConsole",
      "jinja": true,
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "ENABLE_MCP_UI": "true",
        "DEBUGPY_PROCESS_SPAWN_TIMEOUT": "120"
      }
    },
    {
      "name": "CDYP7 API - FastAPI/Uvicorn reload",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "ENABLE_MCP_UI": "true"
      }
    },
    {
      "name": "CDYP7 API - Attach to debugpy",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "justMyCode": false,
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    }
  ]
}